# ==============================================================================
# PrimeMarket / SubFlow Backend Environment Configuration
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-dev-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# DATABASE OPTION 1: Supabase via Connection URI (Recommended)
# Copy from Supabase Dashboard -> Project Settings -> Database -> URI
# Example (Session Pooler - works on all networks):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# DATABASE OPTION 2: Individual Parameters (If DATABASE_URL is left empty)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Frontend URL (Used for generating email verification links)
FRONTEND_URL=http://localhost:3000

# Cloudinary Storage (For image uploads: product images, payment screenshots)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Email Service (Used in accounts/email_utils.py for user verification)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@primemarket.com

# Standard Django Email (Console backend logs emails to terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
